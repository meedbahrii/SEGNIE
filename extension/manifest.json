{
  "manifest_version": 3,
  "name": "Segnie - Save Anywhere Instantly",
  "version": "1.0.0",
  "description": "One-click saves to Google Sheets, Notion, Trello, and PDF. Organize your research across all your favorite apps.",
  "homepage_url": "https://segnie.vercel.app",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://*.vercel.app/*",
    "https://*.replit.app/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "html2canvas.min.js",
        "jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["onboarding.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Quick save current page to last used destination"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open Segnie popup"
    }
  }
}
